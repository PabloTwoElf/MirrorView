{
  "name": "mirror-view",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:signal\" \"npm:dev:app\"",
    "dev:app": "vite --host --port 5173 --strictPort",
